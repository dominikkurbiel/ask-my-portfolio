# Copy to .env in the repo root: cp .env.example .env
# The API reads it automatically (pydantic-settings).

# --- API ---
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5434/ask_my_portfolio
LOG_LEVEL=INFO

# --- Web ---
# Where Next.js forwards /api/* during development
API_URL=http://localhost:8000
